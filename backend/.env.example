APP_NAME=B2B Orders API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DOCS_URL=/api/docs
OPENAPI_URL=/api/openapi.json
LOG_LEVEL=INFO
ENABLE_METRICS=true
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/b2b_db
SECRET_KEY=supersecretkey_for_hackathon_mvp
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_COOKIE_NAME=b2b_access_token
REFRESH_COOKIE_NAME=b2b_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost,http://127.0.0.1
FIRST_SUPERUSER_LOGIN=admin
FIRST_SUPERUSER_PASSWORD=admin123
FIRST_SUPERUSER_FULL_NAME=Системный администратор
SEED_DEMO_MANAGER_LOGIN=manager
SEED_DEMO_MANAGER_PASSWORD=manager123
SEED_DEMO_MANAGER_FULL_NAME=Иван Иванов
SEED_DATA=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
